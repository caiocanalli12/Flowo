# Copie para .env para sobrescrever os padrões do docker-compose.yml (opcional).

# Postgres
POSTGRES_USER=flowo
POSTGRES_PASSWORD=flowo
POSTGRES_DB=flowo
# Porta exposta no host (mude se já houver um Postgres local na 5432)
POSTGRES_HOST_PORT=5432

# Portas expostas no host
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173
